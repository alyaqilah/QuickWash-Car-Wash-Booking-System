<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.quickwashproject.GuideController">
   <children>
      <MenuBar AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <menus>
          <Menu mnemonicParsing="false" text="File">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#handleLogout" text="Logout" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Navigation">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#goToReservation" text="Booking Dashboard" />
              <MenuItem mnemonicParsing="false" onAction="#goToPrice" text="Price Listing" />
              <MenuItem mnemonicParsing="false" onAction="#goToGuide" text="Station Guide" />
              <MenuItem mnemonicParsing="false" onAction="#goToProfile" text="User Profile" />
            </items>
          </Menu>
        </menus>
      </MenuBar>

      <ScrollPane fitToWidth="true" vbarPolicy="AS_NEEDED" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="30.0">
         <content>
            <VBox spacing="18.0" styleClass="dashboard-root">
               <padding>
                  <Insets bottom="30.0" left="30.0" right="30.0" top="20.0" />
               </padding>
               <children>
                  <!-- Hero Banner -->
                  <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="hero-banner">
                     <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="hero-title" text="📖 QuickWash Station Guide &amp; Instructions" />
                              <Label styleClass="hero-subtitle" text="Learn how to use our booking system and view operational guidelines." />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Card 1: How to Book Instructions -->
                  <VBox spacing="10.0" styleClass="modern-card">
                     <padding><Insets bottom="18.0" left="20.0" right="20.0" top="18.0"/></padding>
                     <children>
                        <Label styleClass="card-section-title" text="How to Book a Wash Slot:" />
                        <Label text="1. Enter your vehicle license plate and select your vehicle category (Sedan or SUV/Van)." textFill="#2f3e46" />
                        <Label text="2. Choose your preferred wash tier (Quick Wash, Deluxe Wash, or Full Detail)." textFill="#2f3e46" />
                        <Label text="3. Select any additional service add-ons (Vacuum, Wax Polish, Tire Shine)." textFill="#2f3e46" />
                        <Label text="4. Pick your preferred reservation date and time slot." textFill="#2f3e46" />
                        <Label text="5. Click 'Calculate Total' to apply tier discounts, then click 'Save Reservation' to confirm." textFill="#2f3e46" />
                     </children>
                  </VBox>

                  <!-- Card 2: Station Guidelines & Rules -->
                  <VBox spacing="10.0" styleClass="modern-card">
                     <padding><Insets bottom="18.0" left="20.0" right="20.0" top="18.0"/></padding>
                     <children>
                        <Label styleClass="card-section-title" text="Station Guidelines:" />
                        <Label text="• Please arrive at least 5 minutes prior to your allocated time slot." textFill="#2f3e46" />
                        <Label text="• Remove all valuable belongings from your vehicle before handing it over for detailing." textFill="#2f3e46" />
                        <Label text="• Receipts and booking confirmations are generated automatically upon successful reservation." textFill="#2f3e46" />
                     </children>
                  </VBox>

                  <!-- Action Bar -->
                  <HBox alignment="CENTER_RIGHT" styleClass="checkout-card">
                     <padding><Insets bottom="20.0" left="25.0" right="25.0" top="20.0"/></padding>
                     <children>
                        <Button mnemonicParsing="false" onAction="#goToReservation" styleClass="btn-primary" text="Back to Dashboard" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</AnchorPane>