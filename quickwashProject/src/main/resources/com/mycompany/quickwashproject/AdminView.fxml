<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" styleClass="root-pane" stylesheets="@style.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.quickwashproject.AdminController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <Label styleClass="header-title" text="QuickWash - Admin Portal" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button fx:id="logoutButton" onAction="#handleLogout" styleClass="logout-button" text="Logout" />
         </children>
      </HBox>

      <BarChart fx:id="packageBarChart" prefHeight="250.0">
        <xAxis>
          <CategoryAxis side="BOTTOM" />
        </xAxis>
        <yAxis>
          <NumberAxis side="LEFT" />
        </yAxis>
      </BarChart>

      <VBox spacing="10.0" VBox.vgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label styleClass="section-title" text="All Customer Reservations" />
                  <TextField fx:id="searchField" promptText="Search ID or Plate..." onKeyReleased="#handleSearch" prefWidth="180.0" />
                  <HBox HBox.hgrow="ALWAYS" />
                  <Button fx:id="verifyButton" onAction="#handleVerifyBooking" styleClass="action-button" text="Verify Selected Booking" />
                  <Button fx:id="exportButton" onAction="#handleExportPDFReport" styleClass="action-button" text="Download Full PDF Report" />
               </children>
            </HBox>
            <TableView fx:id="bookingTable" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="idCol" prefWidth="45.0" text="ID" />
                <TableColumn fx:id="customerCol" prefWidth="90.0" text="Customer" />
                <TableColumn fx:id="plateCol" prefWidth="85.0" text="Plate" />
                <TableColumn fx:id="sizeCol" prefWidth="75.0" text="Size" />
                <TableColumn fx:id="packageCol" prefWidth="105.0" text="Package" />
                <TableColumn fx:id="addOnsCol" prefWidth="120.0" text="Add-ons" />
                <TableColumn fx:id="dateCol" prefWidth="95.0" text="Date" />
                <TableColumn fx:id="timeSlotCol" prefWidth="135.0" text="Time Slot" />
                <TableColumn fx:id="priceCol" prefWidth="80.0" text="Total" />
                <TableColumn fx:id="createdAtCol" prefWidth="110.0" text="Timestamp" />
                <TableColumn fx:id="statusCol" prefWidth="115.0" text="Status" />
              </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>